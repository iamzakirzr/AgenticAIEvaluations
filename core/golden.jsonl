// ==========================================================================
// GOLDEN EVALUATION DATASET
// One JSON object per line. Lines starting with // are comments (stripped by
// core.golden.load_golden). Blank lines are ignored.
//
// FIELDS
//   id                 stable identifier -- NEVER renumber, baselines cite it
//   question           what we ask the system
//   reference_answer   what a perfect system would say
//   reference_doc_ids  corpus documents that must be retrieved (empty when
//                      the question is unanswerable)
//   category           single_hop | multi_hop | unanswerable | adversarial
//   difficulty         1 easy lookup .. 3 requires synthesis or resistance
//   rationale          what this item is designed to catch
// ==========================================================================
//
// --- SINGLE HOP -----------------------------------------------------------
// Answer lives in one chunk of one document. If these fail, retrieval itself
// is broken and nothing further is worth measuring.
{"id": "sh-01", "question": "How many dimensions does the nomic-embed-text model produce?", "reference_answer": "nomic-embed-text produces 768 dimensions.", "reference_doc_ids": ["embeddings"], "category": "single_hop", "difficulty": 1, "rationale": "Exact numeric lookup; baseline retrieval sanity check."}
{"id": "sh-02", "question": "What is the range of cosine similarity?", "reference_answer": "Cosine similarity ranges from -1 to 1, where 1 means the vectors point in exactly the same direction.", "reference_doc_ids": ["embeddings"], "category": "single_hop", "difficulty": 1, "rationale": "Simple factual range; later contradicted by an adversarial item."}
{"id": "sh-03", "question": "Why is cosine similarity preferred over Euclidean distance for text embeddings?", "reference_answer": "Euclidean distance is sensitive to vector magnitude, which usually reflects document length rather than meaning. Cosine measures direction only, so it ignores length.", "reference_doc_ids": ["embeddings"], "category": "single_hop", "difficulty": 2, "rationale": "Requires an explanation rather than a lookup."}
{"id": "sh-04", "question": "What is a typical chunk overlap as a percentage of chunk size?", "reference_answer": "A typical overlap is 10 to 20 percent of the chunk size.", "reference_doc_ids": ["chunking"], "category": "single_hop", "difficulty": 1, "rationale": "Numeric range; contradicted by an adversarial item later."}
{"id": "sh-05", "question": "What separators does recursive character splitting try, and in what order?", "reference_answer": "It tries paragraph breaks first, then single newlines, then sentences, then words, falling back to a hard character cut only when no separator produces a small enough piece.", "reference_doc_ids": ["chunking"], "category": "single_hop", "difficulty": 2, "rationale": "Ordered list must be retrieved intact -- breaks if chunk size splits the list."}
{"id": "sh-06", "question": "Why is semantic splitting the most expensive chunking strategy?", "reference_answer": "Because it requires embedding the corpus twice: once to embed each sentence and measure similarity between consecutive sentences, before the final chunks are formed.", "reference_doc_ids": ["chunking"], "category": "single_hop", "difficulty": 2, "rationale": "Causal explanation, not a fact lookup."}
{"id": "sh-07", "question": "What constant k is conventionally used in Reciprocal Rank Fusion?", "reference_answer": "The constant k is conventionally set to 60.", "reference_doc_ids": ["retrieval"], "category": "single_hop", "difficulty": 1, "rationale": "Precise number buried mid-document."}
{"id": "sh-08", "question": "What does the term 'lost in the middle' refer to in retrieval?", "reference_answer": "It refers to the finding that models are measurably worse at using information buried in the middle of a long context, which is why raising top K can harm answer quality.", "reference_doc_ids": ["retrieval"], "category": "single_hop", "difficulty": 1, "rationale": "Named-concept lookup."}
{"id": "sh-09", "question": "What does HyDE stand for and how does it work?", "reference_answer": "HyDE stands for Hypothetical Document Embeddings. It asks the model to write a fake answer to the question and embeds that instead of the question, because the fake answer shares the style and vocabulary of real documents and often matches better.", "reference_doc_ids": ["retrieval"], "category": "single_hop", "difficulty": 2, "rationale": "Acronym expansion plus mechanism."}
{"id": "sh-10", "question": "In Maximum Marginal Relevance, what do lambda values of 1.0 and 0.0 mean?", "reference_answer": "A lambda of 1.0 means pure relevance and 0.0 means pure diversity.", "reference_doc_ids": ["retrieval"], "category": "single_hop", "difficulty": 1, "rationale": "Two-part numeric answer; partial answers should score lower."}
{"id": "sh-11", "question": "Why is a cross-encoder used only on a shortlist rather than the whole corpus?", "reference_answer": "Because cross-encoders read the query and each candidate together, which makes them far more accurate but far slower than embedding similarity, so they are only affordable on a shortlist of 25 to 50 candidates.", "reference_doc_ids": ["retrieval"], "category": "single_hop", "difficulty": 2, "rationale": "Trade-off reasoning."}
{"id": "sh-12", "question": "Which HNSW parameter can be changed after the index is built?", "reference_answer": "ef_search can be changed after the index is built, unlike M and ef_construction.", "reference_doc_ids": ["vector_stores"], "category": "single_hop", "difficulty": 2, "rationale": "Requires distinguishing one item from a list of three."}
{"id": "sh-13", "question": "Up to roughly what corpus size is exact search fast enough to be the right default?", "reference_answer": "Up to roughly one hundred thousand chunks, exact search is fast enough and is the correct default because it removes an entire class of recall bugs.", "reference_doc_ids": ["vector_stores"], "category": "single_hop", "difficulty": 1, "rationale": "Threshold lookup."}
{"id": "sh-14", "question": "What distance metric does Chroma default to?", "reference_answer": "Chroma defaults to cosine distance and uses HNSW under the hood.", "reference_doc_ids": ["vector_stores"], "category": "single_hop", "difficulty": 1, "rationale": "Tool-specific default."}
{"id": "sh-15", "question": "If the first relevant result is in position 4, what is the reciprocal rank?", "reference_answer": "The reciprocal rank is 0.25, because reciprocal rank is one divided by the rank of the first relevant result.", "reference_doc_ids": ["rag_metrics"], "category": "single_hop", "difficulty": 2, "rationale": "Requires applying a formula, not just quoting it."}
{"id": "sh-16", "question": "How is faithfulness computed?", "reference_answer": "The answer is broken into individual claims, each claim is checked against the retrieved context, and the score is the fraction of claims that are supported.", "reference_doc_ids": ["rag_metrics"], "category": "single_hop", "difficulty": 1, "rationale": "Core metric definition."}
{"id": "sh-17", "question": "For which RAG metric is a lower score better?", "reference_answer": "Noise Sensitivity, which measures how often the system produces incorrect claims when irrelevant documents are present in the context.", "reference_doc_ids": ["rag_metrics"], "category": "single_hop", "difficulty": 2, "rationale": "Catches systems that assume all metrics point the same direction."}
{"id": "sh-18", "question": "Which RAG metric requires a reference answer to compute?", "reference_answer": "Context Recall requires a reference answer, because it works by attributing each claim in the reference answer to the retrieved context.", "reference_doc_ids": ["rag_metrics"], "category": "single_hop", "difficulty": 2, "rationale": "Distinguishes reference-based from reference-free metrics."}
{"id": "sh-19", "question": "What does Step Efficiency penalise in an agent?", "reference_answer": "It penalises unnecessary steps: an agent reaching the goal in three tool calls is better than one taking eleven, all else being equal.", "reference_doc_ids": ["agent_metrics"], "category": "single_hop", "difficulty": 1, "rationale": "Agent metric lookup."}
{"id": "sh-20", "question": "Why is loop detection invisible to outcome-only evaluation?", "reference_answer": "Because an agent stuck repeating an action usually eventually times out rather than returning a wrong answer, so an evaluation that only inspects the final output does not register a failure.", "reference_doc_ids": ["agent_metrics"], "category": "single_hop", "difficulty": 2, "rationale": "Explains why trajectory metrics exist."}
{"id": "sh-21", "question": "What does Knowledge Retention measure in a multi-turn chatbot?", "reference_answer": "It checks whether the assistant remembers facts the user stated earlier in the conversation and does not ask for them again.", "reference_doc_ids": ["agent_metrics"], "category": "single_hop", "difficulty": 1, "rationale": "Conversational metric lookup."}
{"id": "sh-22", "question": "What Cohen's kappa value is conventionally described as substantial agreement?", "reference_answer": "Values above 0.6 are conventionally described as substantial agreement, and values above 0.8 as almost perfect.", "reference_doc_ids": ["llm_as_judge"], "category": "single_hop", "difficulty": 1, "rationale": "Calibration threshold; contradicted by an adversarial item."}
{"id": "sh-23", "question": "What is the standard mitigation for position bias in an LLM judge?", "reference_answer": "Run every pairwise comparison twice with the order swapped and keep only the verdicts that agree.", "reference_doc_ids": ["llm_as_judge"], "category": "single_hop", "difficulty": 1, "rationale": "Actionable mitigation lookup."}
{"id": "sh-24", "question": "Why is raw percentage agreement misleading when calibrating a judge on imbalanced data?", "reference_answer": "Because if 90 percent of answers are good, a judge that always says 'good' achieves 90 percent agreement while having a Cohen's kappa of 0, correctly revealing it has learned nothing.", "reference_doc_ids": ["llm_as_judge"], "category": "single_hop", "difficulty": 3, "rationale": "Statistical reasoning with a worked example."}
{"id": "sh-25", "question": "What is the difference between intrinsic and extrinsic hallucination?", "reference_answer": "Intrinsic hallucination contradicts the provided context. Extrinsic hallucination adds information absent from the context, which may even be true in the world but did not come from the sources.", "reference_doc_ids": ["hallucination"], "category": "single_hop", "difficulty": 1, "rationale": "Two-part definition; partial answers should be caught."}
{"id": "sh-26", "question": "What is the single highest-value prompt change in a RAG system?", "reference_answer": "Instructing the model explicitly to answer only from the provided context and to say it does not know when the context is insufficient.", "reference_doc_ids": ["hallucination"], "category": "single_hop", "difficulty": 1, "rationale": "Prescriptive guidance lookup."}
//
// --- MULTI HOP ------------------------------------------------------------
// The answer requires combining facts from two or more documents. No single
// chunk contains it, so these separate context RECALL from context PRECISION
// and punish a retriever tuned only for top-1 accuracy.
{"id": "mh-01", "question": "Raising top K improves context recall but can make answers worse. Explain the mechanism and name the metric that degrades.", "reference_answer": "Raising K drags in more irrelevant text, which lowers context precision, and models are measurably worse at using information buried in the middle of a long context, an effect called lost in the middle. So recall rises while context precision and answer quality fall.", "reference_doc_ids": ["retrieval", "rag_metrics"], "category": "multi_hop", "difficulty": 3, "rationale": "Requires joining the retrieval mechanism to the metric that detects it."}
{"id": "mh-02", "question": "If I make my chunks much smaller, which evaluation metric should I expect to drop, and why?", "reference_answer": "Context recall should drop. Chunks that are too small split a single fact across a boundary so no single chunk contains the whole answer, and context recall measures whether all information needed for the reference answer was present in the retrieved context.", "reference_doc_ids": ["chunking", "rag_metrics"], "category": "multi_hop", "difficulty": 3, "rationale": "Connects a configuration change to a specific metric -- the core skill of this repo."}
{"id": "mh-03", "question": "Why should the generator model and the judge model be configured separately?", "reference_answer": "Because of self-preference bias: a model tends to rate its own outputs more favourably than other models' outputs, so using the same model as both generator and judge inflates scores.", "reference_doc_ids": ["llm_as_judge"], "category": "multi_hop", "difficulty": 2, "rationale": "Directly justifies a design decision in this repo's config."}
{"id": "mh-04", "question": "Lexical embeddings cannot recognise synonyms, yet lexical search is still used in production. Explain why, and name the technique that uses both.", "reference_answer": "Lexical methods handle rare exact terms well, such as product codes, error numbers and proper nouns, where neural models blur distinctions. Combining both is called hybrid search, which typically merges BM25 and vector results using Reciprocal Rank Fusion.", "reference_doc_ids": ["embeddings", "retrieval"], "category": "multi_hop", "difficulty": 3, "rationale": "Requires a fact from embeddings.md and a technique from retrieval.md."}
{"id": "mh-05", "question": "A judge returns malformed JSON. Why must this not be recorded as a score of zero?", "reference_answer": "Because it converts an infrastructure problem into a fake quality regression and corrupts the baseline you compare against. Failed judgements should be recorded as failures and reported separately from scores.", "reference_doc_ids": ["llm_as_judge"], "category": "multi_hop", "difficulty": 2, "rationale": "Operational reasoning that this repo's judge wrapper implements."}
{"id": "mh-06", "question": "My system scores high on faithfulness but low on answer correctness. What is the most likely cause?", "reference_answer": "Retrieval returned the wrong document and the generator faithfully summarised it. Faithfulness only checks whether the answer follows from the retrieved context, not whether the answer is correct, so an answer that faithfully repeats a wrong document scores 1.0.", "reference_doc_ids": ["rag_metrics"], "category": "multi_hop", "difficulty": 3, "rationale": "Diagnostic reasoning combining two metric definitions."}
{"id": "mh-07", "question": "Why does metadata filtering interact badly with HNSW, and what are the two approaches called?", "reference_answer": "If the filter is very selective, the graph walk spends its time in nodes the filter excludes and recall collapses. The two approaches are pre-filtering, which restricts the candidate set first, and post-filtering, which retrieves K results then discards those failing the filter and can return fewer than K.", "reference_doc_ids": ["vector_stores"], "category": "multi_hop", "difficulty": 3, "rationale": "Multi-part answer requiring a full section to be retrieved."}
{"id": "mh-08", "question": "Why is a dataset containing only answerable questions dangerous, and what trade-off appears once you fix it?", "reference_answer": "It cannot detect confident fabrication on questions the corpus does not cover, which is the worst failure mode. Once unanswerable questions are added, a trade-off appears: pushing the system to refuse more often reduces hallucination but increases unhelpful refusals on questions it could have answered, so both directions must be measured together.", "reference_doc_ids": ["hallucination"], "category": "multi_hop", "difficulty": 3, "rationale": "Justifies the unanswerable category of this very dataset."}
{"id": "mh-09", "question": "Averaging metric scores across a dataset can hide a serious problem. What is it and why does it matter?", "reference_answer": "It hides bimodal behaviour: a system answering half the questions perfectly and half catastrophically has the same mean as one answering every question mediocrely, and the two require completely different fixes. The distribution must be inspected, not just the mean.", "reference_doc_ids": ["rag_metrics"], "category": "multi_hop", "difficulty": 2, "rationale": "Statistical literacy about metric reporting."}
{"id": "mh-10", "question": "How does the distinction between outcome and trajectory metrics apply to an agent that reached the right answer after a wrong turn?", "reference_answer": "Outcome metrics would score it as a success because the final answer is correct. Trajectory metrics such as Tool Correctness and Step Efficiency would penalise the wrong turn, and only trajectory metrics let you predict whether the agent will keep working on untested inputs.", "reference_doc_ids": ["agent_metrics"], "category": "multi_hop", "difficulty": 3, "rationale": "Applies a principle to a concrete scenario."}
