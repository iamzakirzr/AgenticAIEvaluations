# Copy to .env and adjust. Every value has a working default, so an empty
# .env is fine -- this file exists to show you the knobs.
#
#   cp .env.example .env

# --- Ollama ----------------------------------------------------------------
# Ollama serves TWO APIs on this port: its native one at /api/*, and an
# OpenAI-compatible one at /v1. Lesson 04 needs the first (for schema-
# constrained decoding), lesson 05 needs the second (RAGAS goes through
# instructor). Both come from this one URL.
OLLAMA_BASE_URL=http://localhost:11434

# --- Models ----------------------------------------------------------------
# The model that ANSWERS questions (the system under test).
CHAT_MODEL=llama3.1:8b

# The model that SCORES answers. Deliberately separate from CHAT_MODEL:
# a model rates its own output more favourably than another model's
# (self-preference bias), so using one model for both inflates every score.
JUDGE_MODEL=llama3.1:8b

# Turns text into vectors.
EMBED_MODEL=nomic-embed-text

# --- Retrieval knobs (the experiment variables) -----------------------------
# Change these and re-run the suites to watch metrics move. That is the
# point of the whole repo.
#   CHUNK_SIZE=300 make experiment-chunking
CHUNK_SIZE=700
CHUNK_OVERLAP=120
TOP_K=4

# --- Generation -------------------------------------------------------------
# 0 for both answerer and judge. A judge with sampling noise makes your metric
# noisy, which destroys your ability to detect small regressions.
TEMPERATURE=0.0
REQUEST_TIMEOUT=120

# --- LangWatch (lesson 06 only, optional) -----------------------------------
# Everything in lesson 06 runs offline without this. Set it only to push
# traces to the hosted dashboard. Sign up at langwatch.ai.
# LANGWATCH_API_KEY=sk-lw-...

# --- DeepEval ---------------------------------------------------------------
# Set automatically by 04_deepeval/ollama_judge.py, listed here so you know
# it exists. Stops DeepEval phoning home and prompting for a cloud login.
DEEPEVAL_TELEMETRY_OPT_OUT=YES
