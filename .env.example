# Copy to .env and edit. Every value can also be set as an environment variable.

# --- Judge: the LLM that scores outputs --------------------------------------
# ollama | openai | anthropic | azure
JUDGE_PROVIDER=ollama
JUDGE_MODEL=llama3.1:8b

# --- System under test: the bundled RAG app, agent and chatbot ----------------
# ollama | openai | scripted   (scripted = deterministic, no model)
SUT_PROVIDER=ollama
SUT_MODEL=llama3.1:8b

OLLAMA_BASE_URL=http://localhost:11434

# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1     # any OpenAI-compatible endpoint
# ANTHROPIC_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21

REQUEST_TIMEOUT_S=120
